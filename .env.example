# Copy values into environment variables (this file is NOT loaded automatically).
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ALLOWED_USER_IDS=123456789
APP_TIME_ZONE=Europe/Madrid
CURRENCY=EUR
# "memory" for the first run; "sheets" for persistent storage
STORAGE_MODE=memory
# Required only if STORAGE_MODE=sheets
SHEETS_ID=REPLACE_WITH_SPREADSHEET_ID
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
